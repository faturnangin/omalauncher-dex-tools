#!/bin/sh
export MOZ_ENABLE_WAYLAND=1
export GDK_BACKEND=wayland
export XDG_CURRENT_DESKTOP=sway

# Audio server for PulseAudio backend
export PULSE_SERVER="unix:/run/user/0/pulse/native"

# Add Firefox library directory to library search path for internal codec libraries
export LD_LIBRARY_PATH="/usr/lib/firefox${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# PRoot compatibility: Disable shared memory seals and namespace sandboxing
# which cause SIGSEGV crashes under PRoot ptrace environment
export MOZ_SHM_NO_SEALS=1
export MOZ_DISABLE_CONTENT_SANDBOX=1
export MOZ_DISABLE_GMP_SANDBOX=1
export MOZ_DISABLE_RDD_SANDBOX=1
export MOZ_DISABLE_UTILITY_SANDBOX=1

export LD_PRELOAD="/usr/local/lib/libfirefox-fix.so${LD_PRELOAD:+:$LD_PRELOAD}"

PROFILE_DIR="/root/.config/firefox-omarchy"
mkdir -p "$PROFILE_DIR/chrome"

# Always clean up stale lock files so dead sessions never block launching
rm -f "$PROFILE_DIR/.parentlock" "$PROFILE_DIR/lock"

# Clean up any stale or corrupted xulstore geometry that forces fixed dimensions
if [ -f "$PROFILE_DIR/xulstore.json" ]; then
    rm -f "$PROFILE_DIR/xulstore.json"
fi

cat << 'EOF' > "$PROFILE_DIR/user.js"
// Disable meta-viewport: on desktop Linux Firefox it locks content viewport and breaks rotation/hit-testing
user_pref("dom.meta-viewport.enabled", false);

// Use native HiDPI rendering via Wayland scale (scale 2 = 540 CSS px in portrait, crisp and sharp)
user_pref("layout.css.devPixelsPerPx", "-1.0");

// Enable compact UI mode
user_pref("browser.compactmode.show", true);
user_pref("browser.uidensity", 1);

// Enable userChrome.css for responsive mobile UI
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);

// Fast, snappy touch scrolling without CPU animation backlog (vital for software WebRender under PRoot)
user_pref("general.smoothScroll", false);
user_pref("general.smoothScroll.lines", false);
user_pref("general.smoothScroll.pages", false);
user_pref("general.smoothScroll.scrollbars", false);
user_pref("general.smoothScroll.pixels", false);
user_pref("general.smoothScroll.mouseWheel", false);

// Disable axis locking: allows vertical, horizontal, and diagonal swipes without getting stuck
user_pref("apz.axis_lock.mode", 0);

// Auto-direct scroll deltas to the scrollable container (handles free diagonal/horizontal/vertical swipes)
user_pref("mousewheel.autodir.enabled", true);
user_pref("mousewheel.autodir.honourroot", true);

// Finger swipe sensitivity & speed (feels like native mobile touch)
user_pref("mousewheel.min_line_scroll_amount", 5);
user_pref("mousewheel.default.delta_multiplier_y", 120);
user_pref("mousewheel.default.delta_multiplier_x", 120);

// Drag responsiveness & prevent script stalls
user_pref("apz.drag.enabled", true);
user_pref("apz.drag.touch.enabled", true);
user_pref("apz.content_response_timeout", 100);

// Disable experimental desktop zoom layers to keep visual viewport perfectly synced with window geometry on rotate
user_pref("apz.allow_zooming", false);
user_pref("apz.allow_double_tap_zooming", false);
user_pref("apz.one_touch_pinch.enabled", false);

// Video & Audio playback: Use RDD process with system FFmpeg and FFVPX codecs
user_pref("media.ffmpeg.enabled", true);
user_pref("media.rdd-process.enabled", true);
user_pref("media.rdd-ffmpeg.enabled", true);
user_pref("media.rdd-ffvpx.enabled", true);
user_pref("media.rdd-vpx.enabled", true);
user_pref("media.rdd-opus.enabled", true);
user_pref("media.rdd-vorbis.enabled", true);
user_pref("media.rdd-wav.enabled", true);
user_pref("media.opus.enabled", true);
user_pref("media.ffmpeg.vaapi.enabled", false);

// Audio playback via PulseAudio
user_pref("media.cubeb.backend", "pulse");

// HTML5 Media Source Extensions (MSE) enabled for YouTube
user_pref("media.mediasource.enabled", true);
user_pref("media.mediasource.webm.enabled", true);
user_pref("media.mediasource.vp9.enabled", true);
user_pref("media.mediasource.mp4.enabled", true);
user_pref("media.av1.enabled", false);
user_pref("media.webm.enabled", true);
user_pref("media.mp4.enabled", true);

// Allow media to play smoothly without autoplay blocks
user_pref("media.autoplay.default", 0);
user_pref("media.autoplay.blocking_policy", 0);

// Software WebRender (smooth & stable under proot)
user_pref("gfx.webrender.software", true);
user_pref("layers.acceleration.disabled", true);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.tabs.warnOnClose", false);
EOF

cat << 'EOF' > "$PROFILE_DIR/chrome/userChrome.css"
/* Omalauncher Responsive Mobile userChrome for Firefox */

:root {
  --tab-min-height: 36px !important;
  --urlbar-min-height: 34px !important;
  --tab-min-width: 40px !important;
  min-width: 0 !important;
  min-height: 0 !important;
}

#main-window,
#browser,
#appcontent {
  min-width: 0 !important;
  min-height: 0 !important;
}

#navigator-toolbox {
  min-width: 0 !important;
  max-width: 100vw !important;
}

#nav-bar {
  min-width: 0 !important;
  padding-inline: 4px !important;
}

#urlbar-container {
  min-width: 80px !important;
}

#urlbar {
  min-width: 80px !important;
}

#TabsToolbar {
  min-width: 0 !important;
}

.tabbrowser-tab {
  min-width: 40px !important;
  padding-inline: 6px !important;
}

#alltabs-button,
#tracking-protection-icon-container {
  display: none !important;
}

/* Completely hide the security sandbox warning banner and notification boxes */
#global-notificationbox,
notification-message,
notification,
.notificationbox-stack {
  display: none !important;
  visibility: hidden !important;
  height: 0 !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
}

.devtools-toolbox-browsing-context,
.devtools-responsive-wrapper {
  min-width: 0 !important;
  min-height: 0 !important;
}
EOF

chmod 755 /usr/local/bin/firefox

exec /usr/bin/firefox --profile "$PROFILE_DIR" "$@" >> /tmp/firefox_runtime.log 2>&1
